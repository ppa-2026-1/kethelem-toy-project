# USER API ================================================================

@host=localhost:8080

### Get all users
# @name= getAllUsers

GET /api/v1/users HTTP/1.1
Host: {{host}}
Accept: application/json

### Create a new valid User
# @name = createNewUser

POST /api/v1/users HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "email": "batata@potato.com",
    "password": "1234RT56",
    "handle": "papas",
    "name": "Kartofel",
    "roles": [
        "ROLE_USER"
    ],
    "company": "potato inc"
}


### Try and create an invalid User
# @name = tryCreateInvalidUser

POST /api/v1/users HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "email": "batata@potato.com",
    "password": "1234",
    "handle": "papas",
    "name": "Kartofel",
    "roles": [
        "ROLE_USER"
    ],
    "company": "potato inc"
}


### Criar usuário Kethelem
# @name = createKethelem

POST /api/v1/users HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "email": "kethelem.socoowski@gmail.com",
    "password": "Keth1234",
    "handle": "kethelem",
    "name": "Kethelem Socoowski",
    "roles": [
        "ROLE_USER"
    ]
}


# TICKET API ================================================================

### Criar ticket (assignee = creator)
# @name = createTicketNoAssignee

POST /api/v1/tickets HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "action": "Corrigir",
    "object": "Bug no login",
    "details": "O botão de login não responde no mobile",
    "creatorId": 1
}

### Criar ticket com assignee diferente
# @name = createTicketWithAssignee

POST /api/v1/tickets HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "action": "Revisar",
    "object": "Documentação da API",
    "details": "Revisar todos os endpoints do swagger",
    "creatorId": 1,
    "assigneeId": 2
}

### Criar ticket com observers
# @name = createTicketWithObservers

POST /api/v1/tickets HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "action": "Implementar",
    "object": "Relatório mensal",
    "details": "Gerar PDF com os dados do mês",
    "creatorId": 1,
    "observers": ["gestor@empresa.com", "diretor@empresa.com"]
}

### Listar todos os tickets
# @name = listTickets

GET /api/v1/tickets HTTP/1.1
Host: {{host}}
Accept: application/json

### Buscar ticket por id
# @name = getTicket

GET /api/v1/tickets/1 HTTP/1.1
Host: {{host}}
Accept: application/json

### Colocar ticket em andamento (seta responsável)
# @name = ticketEmAndamento

PATCH /api/v1/tickets/1/status HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "status": "EM_ANDAMENTO",
    "responsibleId": 1
}

### Fechar ticket
# @name = ticketFechado

PATCH /api/v1/tickets/1/status HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "status": "FECHADO"
}

### Cancelar ticket (com motivo)
# @name = ticketCancelado

PATCH /api/v1/tickets/1/status HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "status": "CANCELADO",
    "reason": "Cliente desistiu da solicitação"
}


# TICKET API - INVÁLIDOS ====================================================

### Criar ticket sem action
# @name = createTicketSemAction

POST /api/v1/tickets HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "object": "Bug no login",
    "creatorId": 1
}

### Criar ticket sem creatorId
# @name = createTicketSemCreator

POST /api/v1/tickets HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "action": "Corrigir",
    "object": "Bug no login"
}

### Colocar em andamento sem responsibleId
# @name = andamentoSemResponsavel

PATCH /api/v1/tickets/1/status HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "status": "EM_ANDAMENTO"
}

### Cancelar sem motivo
# @name = cancelarSemMotivo

PATCH /api/v1/tickets/1/status HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "status": "CANCELADO"
}

### Buscar ticket inexistente
# @name = getTicketInexistente

GET /api/v1/tickets/999 HTTP/1.1
Host: {{host}}
Accept: application/json